[Unit]
Description=Vela Client — gRPC daemon for IV&V hardware validation
Documentation=https://github.com/SiliconCentric/Vela-Client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5 [Service]
Type=simple
User=vela
Group=vela
WorkingDirectory=/var/lib/vela
# Starts BOTH listeners:
# - ClientService (stream path → Server, default port 50051)
# - HalService (SDK/E2E path, default port 50052)
ExecStart=/usr/bin/vela-client
Restart=on-failure
RestartSec=5 # Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vela-client # Hardening
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ReadWritePaths=/var/lib/vela
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes [Install]
WantedBy=multi-user.target
